# Deployment files must keep Unix line endings when packaged from Windows.
*.sh text eol=lf
deploy/*.service text eol=lf
deploy/*.timer text eol=lf
deploy/apply_release.py text eol=lf
deploy/Caddyfile.ip text eol=lf

*.png binary
*.pptx binary
*.docx binary

# Retain upstream notice bytes, including their original whitespace.
docs/licenses/Gaze360-Research-License.md -text -whitespace
docs/licenses/Gaze360-Dataset-Citation.md -text -whitespace
docs/licenses/MPIIFaceGaze-CC-BY-NC-SA-4.0.txt -text -whitespace
