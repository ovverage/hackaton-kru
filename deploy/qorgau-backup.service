[Unit]
Description=Back up Qorgau database and referenced media
After=qorgau.service

[Service]
Type=oneshot
User=qorgau
Group=qorgau
ExecStart=/usr/bin/python3 /opt/qorgau/current/deploy/qorgau-backup.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# SQLite may need its WAL shared-memory file even for a read-only connection.
ReadWritePaths=/var/lib/qorgau /var/backups/qorgau
