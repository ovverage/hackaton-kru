{
  "name": "Qorgau",
  "concept": "Бланк ответов: закрашенный кружок = состояние, угловые метки регистрации = то, на что смотрит камера",
  "color": {
    "paper":      { "value": "#F4F5F7", "use": "фон приложения и кабинета" },
    "sheet":      { "value": "#FFFFFF", "use": "панели, бланки, окна" },
    "graphite":   { "value": "#22252B", "use": "основной текст, закрашенный кружок «пишет тест», метки регистрации" },
    "pencil":     { "value": "#5B6270", "use": "вторичный текст (контраст 6.1:1 на белом)" },
    "faint":      { "value": "#9AA0AA", "use": "только не-текст: пунктир «нет связи», неактивные кружки" },
    "rule":       { "value": "#D9DDE3", "use": "рамки, разделители" },
    "ruleSoft":   { "value": "#E9ECF0", "use": "разделители строк" },
    "ink":        { "value": "#0B6474", "use": "главное действие, ссылки, фокус, выбранный пункт меню, логотип (белый текст 6.8:1)" },
    "inkStrong":  { "value": "#08505D", "use": "hover главной кнопки, текст на inkTint" },
    "inkTint":    { "value": "#E2F0F1", "use": "подложка выбранного, «на связи», подсказки" },
    "amber":      { "value": "#9A5B07", "use": "текст «ждёт решения», «что сделать» (5.4:1)" },
    "amberFill":  { "value": "#F0B33E", "use": "флажок события, напоминание о взгляде (текст на нём — graphite)" },
    "amberTint":  { "value": "#FCF1DC", "use": "подложка «ждёт решения»" },
    "red":        { "value": "#B5302F", "use": "текст «на паузе» (6.1:1)" },
    "redFill":    { "value": "#C83A36", "use": "кружок «на паузе», полоса экрана паузы (белый текст 5.1:1), счётчик в меню" },
    "redTint":    { "value": "#FBE9E7", "use": "подложка «на паузе»" },
    "scene":      { "value": "#2A2E35", "use": "фон кадра камеры/видео" }
  },
  "font": {
    "family": "Geologica",
    "fallback": ["Segoe UI", "system-ui", "sans-serif"],
    "files": {
      "web": "fonts/Geologica-Variable.woff (ось wght 100–900)",
      "qt": ["fonts/static/Geologica-Regular.ttf", "fonts/static/Geologica-Medium.ttf", "fonts/static/Geologica-SemiBold.ttf", "fonts/static/Geologica-Bold.ttf"]
    },
    "license": "SIL OFL 1.1 (fonts/OFL.txt)",
    "numerals": "tabular-nums везде, где цифры: время, счётчики, номера мест"
  },
  "type": {
    "hero":    { "size": 72, "weight": 650, "lineHeight": 0.98, "tracking": "-0.03em", "use": "«Позовите преподавателя» на экране паузы" },
    "display": { "size": 48, "weight": 650, "lineHeight": 1.04, "tracking": "-0.022em", "use": "«9 из 12», крупные итоги" },
    "h1":      { "size": 36, "weight": 650, "lineHeight": 1.1, "tracking": "-0.018em" },
    "h2":      { "size": 21, "weight": 600, "lineHeight": 1.25 },
    "h3":      { "size": 16, "weight": 600, "lineHeight": 1.35 },
    "lead":    { "size": 16, "weight": 400, "lineHeight": 1.5, "color": "pencil" },
    "body":    { "size": 14, "weight": 400, "lineHeight": 1.5 },
    "small":   { "size": 12, "weight": 400, "lineHeight": 1.45, "color": "pencil" },
    "tally":   { "size": 36, "weight": 650, "use": "числа в итогах аудитории" },
    "note": "В Qt вес 650 недоступен в статике — используйте SemiBold (600) или Bold (700)"
  },
  "radius": { "sheet": 4, "chip": 6, "input": 8, "button": 10, "panel": 10, "modal": 16, "pill": 999, "bubble": "50%" },
  "size": {
    "touchTarget": 44,
    "button": { "default": 44, "small": 36, "large": 52 },
    "bubble": { "xs": 9, "sm": 12, "md": 16, "counter": 18, "card": 20, "lg": 30 },
    "regMark": 9,
    "stepBubble": 28,
    "sidebar": 248,
    "contentPaddingX": 40
  },
  "shadow": {
    "modal": "0 24px 64px rgba(20,22,26,.28)",
    "overlay": "0 12px 32px rgba(20,22,26,.22)",
    "note": "Тени только у всплывающего: модальные окна, меню, напоминание о взгляде. У панелей теней нет."
  },
  "breakpoints": { "phone": 720 }
}
